{
  "manifest_version": 3,
  "name": "Paper Lantern",
  "version": "0.1.0",
  "description": "PDF를 로컬에서 읽고 Chrome 내장 AI로 번역합니다. 원문과 번역문을 함께 하이라이트합니다.",
  "minimum_chrome_version": "138",
  "action": {
    "default_title": "Paper Lantern 열기"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "pdf-host.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "assets/*",
        "cmaps/*",
        "standard_fonts/*",
        "wasm/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http: https: file:;"
  }
}
